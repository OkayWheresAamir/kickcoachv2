# Secrets
.env
.env.*
!.env.example

# Video and frames are never committed (copyright and privacy).
# Only the manifest (URLs + timestamps), label files (coordinates) and numbers derived from
# the clips (below) are.
data/raw/
# Each clip's meta.json (frame times, fps, image size; no pixels) is committed so the evals
# rerun from a fresh clone without the video (DEC-031).
data/frames/*/*
!data/frames/*/meta.json
*.mp4
*.mov
*.webm
*.mkv

# Regenerable caches and downloaded model weights. Pose keypoints and ball detections are
# numbers derived from the clips, like the labels, and are committed so every eval reruns
# from a fresh clone (DEC-031).
data/cache/*
!data/cache/pose/
!data/cache/ball/
models/
*.tflite
*.onnx
*.pt
*.pth

# Source papers for norm extraction: store URLs in knowledge/sources.md, not the PDFs
knowledge/papers/
# Coaching corpus sources (Phase 8): only short quoted chunks + URLs are committed
knowledge/coaching_sources/

# Personal
Aamir_Hashmi_Resume*.pdf
CLAUDE.local.md

# Local databases
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# OS / editor
.DS_Store
.vscode/
.idea/

# Failure-analysis renders are video frames (eval/failures.py regenerates them)
data/failures/

# Per-session artifacts from the API (pose arrays, ball candidates, responses)
data/sessions/
